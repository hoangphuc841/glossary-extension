{
  "manifest_version": 3,
  "name": "PDF Book Quick Glossary",
  "version": "1.0.0",
  "description": "Inline glossary badges, hover definitions, quick selection add, and loose term search inside PDF tabs.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core/matcher.js",
        "core/storage.js",
        "content/ui.js",
        "content/viewer.js"
      ],
      "css": [
        "content/styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "search-similar-terms": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Search similar terms in glossary from selection"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "vendor/pdf.mjs",
        "vendor/pdf.worker.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
